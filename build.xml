<?xml version="1.0" encoding="UTF-8"?>


<project name="vxpayment" basedir=".">

	<property name="php" value="/home/php/bin/php"/>
	<property name="bin" value="${basedir}/bin"/>
	<property name="vendor_bin" value="${basedir}/vendor/bin"/>
	<property name="build_dir" value="${basedir}/dist"/>
	<property name="src_dir" value="${basedir}/src/"/>
	<property name="http_root" value="${basedir}/http-root/"/>
	<property name="tests_dir" value="${basedir}/tests"/>
	<property name="bdd_dir" value="${basedir}/features"/>
	<property name="server_port" value="9123"/>
	<property name="server_host" value="localhost"/>
	<property name="npm" value="/opt/node12/bin/npm"/>
	<property name="jshint" value="${basedir}/node_modules/.bin/jshint"/>
	<property name="karma" value="${basedir}/node_modules/karma/bin/karma"/>
	<property name="dalek" value="${basedir}/node_modules/.bin/dalek"/>
	<property name="uglifyjs" value="${basedir}/node_modules/.bin/uglifyjs"/>
    <property name="grunt" value="${basedir}/node_modules/.bin/grunt"/>

	<target name="clean" description="Removes build folders and stuff like that">
		<delete dir="${basedir}/build"/>

		<mkdir dir="${basedir}/build"/>
		<mkdir dir="${basedir}/build/coverage"/>
		<mkdir dir="${basedir}/build/logs"/>
		<mkdir dir="${basedir}/build/pdepend"/>
		<mkdir dir="${basedir}/build/docs"/>
	</target>

	<target name="gettext" description="Produces GNU gettext MO files">
		<exec dir="${bin}" executable="${php}">
			<arg line="gettext.php"/>
		</exec>
	</target>

	<!-- Release Tasks -->
	<target name="deleteBuild" description="Deletes generated versions">
		<delete file="${basedir}/vxpay-iframe-api.min.js"/>
		<delete file="${basedir}/vxpay-iframe.min.js"/>
		<delete file="${basedir}/vxpay-iframe-dev.js"/>
	</target>

	<target name="compressjs" description="Compresses the JS Files">
		<exec dir="${basedir}" executable="${uglifyjs}">
			<arg value="${basedir}/vxpay-iframe.js"/>
			<arg value="--comments"/>
			<arg value="/version/"/>
			<arg value="-o"/>
			<arg value="${basedir}/vxpay-iframe-api.min.js"/>
		</exec>
	</target>

	<target name="dev" description="Installs all packages for development" depends="dev-npm">
		<mkdir dir="${basedir}/http-root"/>
		<exec executable="ln">
			<arg value="-s"/>
			<arg path="${basedir}/vxpay-iframe.js"/>
			<arg path="${basedir}/http-root/vxpay-iframe.js"/>
		</exec>
		<exec executable="ln">
			<arg value="-s"/>
			<arg path="${basedir}/vxpay-iframe.min.js"/>
			<arg path="${basedir}/http-root/vxpay-iframe.min.js"/>
		</exec>
		<exec executable="ln">
			<arg value="-s"/>
			<arg path="${basedir}/spin.min.js"/>
			<arg path="${basedir}/http-root/spin.min.js"/>
		</exec>
	</target>

	<target name="dev-npm">
		<mkdir dir="${basedir}/node_modules"/>
		<exec executable="${npm}">
			<arg value="install"/>
			<arg value="--save-dev"/>
		</exec>
	</target>

	<target name="jshint">
		<exec executable="${jshint}">
			<arg value="--exclude-path=${basedir}/.jshintignore"/>
			<arg path="${basedir}/vxpay-iframe.js"/>
		</exec>
	</target>

	<target name="karma">
		<exec executable="${karma}">
			<arg value="start"/>
			<arg path="${tests_dir}/karma.conf.js"/>
		</exec>
	</target>

	<target name="version-tag">
		<exec executable="node" resolveexecutable="true" outputproperty="apiVersionNew">
			<arg value="-e"/>
			<arg value="console.log(require('${basedir}/package.json').version);"/>
		</exec>

		<replaceregexp file="${basedir}/vxpay-iframe.js"
					   match="(@version [0-9\.\-a-z]+)"
					   replace="@version ${apiVersionNew}"
					   byline="true"
				/>
	</target>

    <target name="dev-grunt">
        <exec executable="${grunt}"></exec>
    </target>

    <target name="npm-pack" description="pack as a tarball">
	<exec executable="${npm}" dir="${build_dir}">
	    <arg value="pack"/>
	    <arg path="${basedir}"/>
	</exec>
    </target>

	<target name="build" depends="jshint,deleteBuild,version-tag,compressjs,dev-grunt">
	</target>

	<target name="release" description="release a new build version">
		<exec executable="git" resolveexecutable="true" failonerror="true">
			<arg value="pull"/>
		</exec>
		<exec executable="node" resolveexecutable="true" outputproperty="apiVersion">
			<arg value="-e"/>
			<arg value="console.log(require('${basedir}/package.json').version);"/>
		</exec>

		<echo message="Current version: ${apiVersion}" />

		<input
			message="Please enter the new version:"
			addproperty="libver"
			/>

		<replaceregexp file="${basedir}/package.json"
		               match='(version": "[0-9\.\-a-z]+)"'
		               replace='version": "${libver}"'
		               byline="true"
			/>

		<antcall target="build" />
		<antcall target="npm-pack" />

		<exec executable="git" resolveexecutable="true" failonerror="true">
			<arg value="commit"/>
			<arg value="-am"/>
			<arg value="Api build"/>
		</exec>
		<exec executable="git" resolveexecutable="true" failonerror="true">
			<arg value="tag"/>
			<arg value="${libver}"/>
		</exec>
		<echo message="New version is ${libver}. You can now run: git push &amp;&amp; git push --tags " />
	</target>

	<target name="push">
		<exec executable="git" resolveexecutable="true" failonerror="true">
			<arg value="push"/>
		</exec>
		<exec executable="git" resolveexecutable="true" failonerror="true">
			<arg value="push"/>
			<arg value="--tags"/>
		</exec>
	</target>

	<target name="init" description="Installs all packages for development" depends="dev">
	</target>

	<target name="test" depends="karma">
	</target>

</project>
